@model proje_mvc.Models.FinansModel
@{
    ViewData["Title"] = "Yeni Kasa İşlemi";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-premium">
            <div class="p-4 border-bottom bg-light bg-opacity-50">
                <h5 class="mb-0 fw-bold"><i class="bi bi-wallet2 me-2 text-primary"></i> Yeni Finansal İşlem Kaydı</h5>
                <p class="text-muted small mb-0 mt-1">Gelir veya gider kaydını sisteme işlemek için formu doldurunuz.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="tarih" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="tarih" type="date" class="form-control rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="tip" class="form-label small fw-bold text-muted"></label>
                            <select asp-for="tip" class="form-select rounded-3">
                                <option value="Gelir">Gelir (+)</option>
                                <option value="Gider">Gider (-)</option>
                            </select>
                        </div>
                        
                        <div class="col-12">
                            <label asp-for="aciklama" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="aciklama" class="form-control rounded-3" placeholder="İşlem detayını belirtiniz..." />
                            <span asp-validation-for="aciklama" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="kategori" class="form-label small fw-bold text-muted"></label>
                            <select asp-for="kategori" class="form-select rounded-3">
                                <option value="Satış Geliri">Satış Geliri</option>
                                <option value="Hizmet Geliri">Hizmet Geliri</option>
                                <option value="Maaş Ödemesi">Maaş Ödemesi</option>
                                <option value="Kira Gideri">Kira Gideri</option>
                                <option value="Fatura Ödemesi">Fatura Ödemesi</option>
                                <option value="Genel Gider">Genel Gider</option>
                                <option value="Diğer">Diğer</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="odeme_yontemi" class="form-label small fw-bold text-muted"></label>
                            <select asp-for="odeme_yontemi" class="form-select rounded-3">
                                <option value="Banka">Banka Transferi / EFT</option>
                                <option value="Nakit">Nakit İşlem</option>
                                <option value="Kredi Kartı">Kredi Kartı</option>
                                <option value="Çek/Senet">Çek / Senet</option>
                            </select>
                        </div>

                        <div class="col-md-12">
                            <div class="p-3 bg-light rounded-3 border border-primary border-opacity-25 mt-2">
                                <label asp-for="tutar" class="form-label small fw-bold text-muted">İşlem Tutarı</label>
                                <div class="input-group input-group-lg">
                                    <input asp-for="tutar" type="number" step="0.01" class="form-control border-end-0 bg-white fw-bold" placeholder="0.00" />
                                    <span class="input-group-text bg-white border-start-0 text-primary fw-bold">₺</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/Finans/Index" class="btn btn-secondary rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-primary-corporate rounded-pill px-5">
                            <i class="bi bi-check-circle me-2"></i> İşlemi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
