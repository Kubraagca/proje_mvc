<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card-premium p-4 border-start border-success border-4">
            <div class="d-flex align-items-center">
                <div class="bg-success bg-opacity-10 p-3 rounded-3 me-3">
                    <i class="bi bi-graph-up-arrow text-success fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Toplam Gelir</h6>
                    <h3 class="mb-0 fw-bold">@ViewBag.ToplamGelir.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-premium p-4 border-start border-danger border-4">
            <div class="d-flex align-items-center">
                <div class="bg-danger bg-opacity-10 p-3 rounded-3 me-3">
                    <i class="bi bi-graph-down-arrow text-danger fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Toplam Gider</h6>
                    <h3 class="mb-0 fw-bold">@ViewBag.ToplamGider.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card-premium p-4 border-start border-primary border-4">
            <div class="d-flex align-items-center">
                <div class="bg-primary bg-opacity-10 p-3 rounded-3 me-3">
                    <i class="bi bi-wallet2 text-primary fs-3"></i>
                </div>
                <div>
                    <h6 class="text-muted mb-1">Net Kasa Durumu</h6>
                    <h3 class="mb-0 fw-bold">@ViewBag.NetDurum.ToString("C2")</h3>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card-premium overflow-hidden">
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light bg-opacity-50">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2"></i> Kasa Hareketleri</h5>
        <a href="/Finans/Ekle" class="btn btn-primary-corporate btn-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-2"></i> Yeni İşlem
        </a>
    </div>
    <div class="p-0">
        <table class="table-corporate mb-0">
            <thead>
                <tr>
                    <th>Tarih</th>
                    <th>Açıklama</th>
                    <th>Modül / Tip</th>
                    <th>Tutar</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-medium text-secondary small">@item.tarih.ToString("dd MMM yyyy")</td>
                        <td class="fw-semibold">@item.aciklama</td>
                        <td>
                            <span class="badge rounded-pill bg-@(item.tip == "Gelir" ? "success" : "danger") bg-opacity-10 text-@(item.tip == "Gelir" ? "success" : "danger") border border-@(item.tip == "Gelir" ? "success" : "danger") border-opacity-25 px-3">
                                @item.tip
                            </span>
                            <span class="text-muted small ms-2">@item.kategori</span>
                        </td>
                        <td class="fw-bold text-@(item.tip == "Gelir" ? "success" : "danger")">
                            @(item.tip == "Gelir" ? "+" : "-") @item.tutar.ToString("C2")
                        </td>
                        <td class="text-end">
                            <form asp-controller="Finans" asp-action="Sil" asp-route-id="@item.id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-link link-danger p-0" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
