@{
    ViewData["Title"] = "ERP Kontrol Paneli";
    var duyurular = ViewBag.Duyurular as List<string>;
    var events = ViewBag.AllEvents;
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css' rel='stylesheet' />
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js'></script>
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Stats fetching
            fetch('/api/statistics/counts')
                .then(response => response.json())
                .then(data => {
                    if(document.getElementById('statPersonel')) document.getElementById('statPersonel').innerText = data.totalPersonel;
                    if(document.getElementById('statUrun')) document.getElementById('statUrun').innerText = data.totalUrun;
                    if(document.getElementById('statMusteri')) document.getElementById('statMusteri').innerText = data.totalMusteri;
                    if(document.getElementById('statGelir')) document.getElementById('statGelir').innerText = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(data.totalGelir);
                    if(document.getElementById('statGider')) document.getElementById('statGider').innerText = new Intl.NumberFormat('tr-TR', { style: 'currency', currency: 'TRY' }).format(data.totalGider);
                    
                    const ctx = document.getElementById('erpMainChart')?.getContext('2d');
                    if (ctx) {
                        new Chart(ctx, {
                            type: 'line',
                            data: {
                                labels: ['Pazartesi', 'Salı', 'Çarşamba', 'Perşembe', 'Cuma', 'Cumartesi', 'Pazar'],
                                datasets: [{
                                    label: 'Gelir Akışı',
                                    data: [12000, 19000, 15000, 25000, 22000, 30000, 28000],
                                    borderColor: '#3b82f6',
                                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                                    fill: true,
                                    tension: 0.4
                                }, {
                                    label: 'Gider Akışı',
                                    data: [8000, 12000, 11000, 18000, 15000, 21000, 19000],
                                    borderColor: '#ef4444',
                                    backgroundColor: 'rgba(239, 68, 68, 0.05)',
                                    fill: true,
                                    tension: 0.4
                                }]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                plugins: { legend: { position: 'bottom' } },
                                scales: { y: { beginAtZero: true }, x: { grid: { display: false } } }
                            }
                        });
                    }
                });

            // Advanced Calendar
            var calendarEl = document.getElementById('calendar');
            if (calendarEl) {
                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'dayGridMonth',
                    locale: 'tr',
                    firstDay: 1,
                    headerToolbar: { 
                        left: 'prev,next today', 
                        center: 'title', 
                        right: 'dayGridMonth,timeGridWeek,timeGridDay' 
                    },
                    buttonText: {
                        today: 'Bugün',
                        month: 'Ay',
                        week: 'Hafta',
                        day: 'Gün'
                    },
                    events: @Html.Raw(Json.Serialize(ViewBag.AllEvents)),
                    themeSystem: 'bootstrap5',
                    height: 550,
                    selectable: true,
                    dateClick: function(info) {
                        // Seçilen tarihi her iki formdaki başlangıç/bitiş alanlarına doldur
                        const dateStr = info.dateStr;
                        document.getElementById('event_start_gorev').value = dateStr + "T09:00";
                        document.getElementById('event_end_gorev').value = dateStr + "T18:00";
                        document.getElementById('event_start_izin').value = dateStr + "T09:00";
                        document.getElementById('event_end_izin').value = dateStr + "T18:00";
                        
                        var modal = new bootstrap.Modal(document.getElementById('addEventModal'));
                        modal.show();
                    },
                    eventClick: function(info) {
                        alert('Etkinlik: ' + info.event.title + '\nDetay: ' + (info.event.extendedProps.description || 'Yok'));
                    }
                });
                calendar.render();
            }
        });
    </script>
}

@if (User.Identity.IsAuthenticated)
{
    <!-- STAT CARDS -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card-premium p-4 border-0 shadow-sm position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-10"><i class="bi bi-people-fill display-4"></i></div>
                <h6 class="text-muted small text-uppercase fw-extrabold mb-1">Toplam Kadro</h6>
                <h2 class="fw-black mb-0" id="statPersonel">...</h2>
                <div class="mt-3 small text-success"><i class="bi bi-arrow-up-short"></i> %2.4 artış</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-premium p-4 border-0 shadow-sm position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-10"><i class="bi bi-box-seam display-4"></i></div>
                <h6 class="text-muted small text-uppercase fw-extrabold mb-1">Stoktaki Ürünler</h6>
                <h2 class="fw-black mb-0" id="statUrun">...</h2>
                <div class="mt-3 small text-primary">Operasyona hazır</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-premium p-4 border-0 shadow-sm position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-10 text-success"><i class="bi bi-currency-dollar display-4"></i></div>
                <h6 class="text-muted small text-uppercase fw-extrabold mb-1">Toplam Ciro</h6>
                <h2 class="fw-black mb-0 text-success" id="statGelir">...</h2>
                <div class="mt-3 small text-muted">Cari dönem</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card-premium p-4 border-0 shadow-sm position-relative overflow-hidden h-100">
                <div class="position-absolute top-0 end-0 p-3 opacity-10 text-danger"><i class="bi bi-graph-down display-4"></i></div>
                <h6 class="text-muted small text-uppercase fw-extrabold mb-1">Toplam Gider</h6>
                <h2 class="fw-black mb-0 text-danger" id="statGider">...</h2>
                <div class="mt-3 small text-muted">Maaşlar dahil</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- LEFT CONTENT: Chart & Activities -->
        <div class="col-lg-7">
            <div class="card-premium p-4 shadow-sm border-0 mb-4" style="min-height: 450px;">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold text-primary mb-0"><i class="bi bi-activity me-2"></i> Operasyonel Performans Analizi</h5>
                    <div class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">Canlı Veri</div>
                </div>
                <div style="height: 350px;">
                    <canvas id="erpMainChart"></canvas>
                </div>
            </div>

            <div class="card-premium p-4 shadow-sm border-0">
                <h6 class="fw-bold text-primary mb-4"><i class="bi bi-list-stars me-2"></i> Yaklaşan Kritik Süreçler</h6>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr class="border-bottom">
                                <td width="50" class="py-3"><div class="bg-warning bg-opacity-10 p-2 rounded-3 text-warning text-center"><i class="bi bi-lightning-fill"></i></div></td>
                                <td><h6 class="mb-0 fw-bold">Stok Yenileme</h6><span class="x-small text-muted">Depo A-42 seviyesi kritik.</span></td>
                                <td class="text-end"><span class="badge bg-light text-dark border">Bugün</span></td>
                            </tr>
                            <tr class="border-bottom">
                                <td class="py-3"><div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary text-center"><i class="bi bi-file-earmark-text"></i></div></td>
                                <td><h6 class="mb-0 fw-bold">Aylık Finans Raporu</h6><span class="x-small text-muted">Yönetim kurulu sunumu hazırlanacak.</span></td>
                                <td class="text-end"><span class="badge bg-light text-dark border">Yarın</span></td>
                            </tr>
                            <tr>
                                <td class="py-3"><div class="bg-success bg-opacity-10 p-2 rounded-3 text-success text-center"><i class="bi bi-people"></i></div></td>
                                <td><h6 class="mb-0 fw-bold">Ekip Motivasyon Toplantısı</h6><span class="x-small text-muted">Dış mekan etkinliği planlaması.</span></td>
                                <td class="text-end"><span class="badge bg-light text-dark border">22 Mayıs</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- RIGHT CONTENT: Calendar & Quick Actions -->
        <div class="col-lg-5">
            <!-- COMPACT CALENDAR (İstenen Yer) -->
            <div class="card-premium p-4 shadow-lg border-0 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-primary mb-0"><i class="bi bi-calendar3 me-2"></i> Kurumsal Planlama</h6>
                    <button class="btn btn-primary-corporate btn-sm px-3 rounded-pill" data-bs-toggle="modal" data-bs-target="#addEventModal">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div id="calendar" class="fc-compact"></div>
            </div>


            <div class="card-premium h-auto border-0 shadow-sm overflow-hidden">
                <div class="p-3 border-bottom bg-light bg-opacity-50">
                    <h6 class="mb-0 fw-bold text-primary small"><i class="bi bi-megaphone-fill me-2"></i> Duyurular</h6>
                </div>
                <div class="p-3">
                    @if (duyurular != null && duyurular.Any())
                    {
                        foreach (var duyuru in duyurular.Take(2))
                        {
                            <div class="d-flex align-items-start mb-3 last-mb-0">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle text-primary me-2">
                                    <i class="bi bi-info-circle" style="font-size: 0.8rem;"></i>
                                </div>
                                <div>
                                    <p class="mb-0 x-small fw-medium text-dark">@duyuru</p>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- GUEST WELCOME SCREEN -->
    <div class="row min-vh-75 align-items-center justify-content-center">
        <div class="col-lg-8 text-center p-5">
            <div class="mb-5 animate-bounce text-primary"><i class="bi bi-shield-lock-fill" style="font-size: 5rem;"></i></div>
            <h1 class="display-4 fw-black text-primary mb-3">ZENITH ERP <span class="fw-light">Platformu</span></h1>
            <p class="lead text-muted mb-5">Operasyonel mükemmellik ve kurumsal verimlilik için lütfen giriş yapınız.</p>
            <a href="/home/giris" class="btn btn-primary-corporate btn-lg rounded-pill px-5 py-3 fw-bold shadow">
                Sisteme Başla <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
}

<!-- ADD EVENT MODAL -->
<div class="modal fade" id="addEventModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1.5rem;">
            <div class="modal-header border-0 p-4 pb-0">
                <h5 class="fw-bold text-primary mb-0"><i class="bi bi-calendar-plus me-2"></i> Yeni Planlama</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <ul class="nav nav-pills nav-fill mb-4 bg-light p-2 rounded-4" role="tablist">
                    <li class="nav-item shadow-sm">
                        <button class="nav-link active rounded-3 fw-bold" data-bs-toggle="pill" data-bs-target="#tabGorev" type="button">🎯 Görev</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link rounded-3 fw-bold" data-bs-toggle="pill" data-bs-target="#tabIzin" type="button">🌴 İzin</button>
                    </li>
                </ul>
                <div class="tab-content">
                    <!-- GÖREV SEKMESİ -->
                    <div class="tab-pane fade show active" id="tabGorev">
                        <form action="/Home/gorev_kaydet" method="post">
                            <div class="mb-3">
                                <label class="form-label x-small fw-bold text-muted">GÖREV ADI</label>
                                <input type="text" name="gorev_adi" class="form-control rounded-3" required placeholder="Toplantı, Raporlama vb.">
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label x-small fw-bold text-muted">BAŞLANGIÇ</label>
                                    <input type="datetime-local" id="event_start_gorev" name="gorev_baslangic_tarihi" class="form-control rounded-3" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label x-small fw-bold text-muted">BİTİŞ</label>
                                    <input type="datetime-local" id="event_end_gorev" name="gorev_bitis_tarihi" class="form-control rounded-3" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label x-small fw-bold text-muted">AÇIKLAMA</label>
                                <textarea name="gorev_aciklama" class="form-control rounded-3" rows="2" placeholder="Görev detayları..."></textarea>
                            </div>
                            <div class="d-grid"><button type="submit" class="btn btn-primary-corporate py-2 rounded-3 fw-bold">Görev Oluştur</button></div>
                        </form>
                    </div>

                    <!-- İZİN SEKMESİ -->
                    <div class="tab-pane fade" id="tabIzin">
                        <form action="/Home/izin_ekle" method="post">
                            <div class="mb-3">
                                <label class="form-label x-small fw-bold text-muted">İZİN TÜRÜ</label>
                                <select name="izin_turu" class="form-select rounded-3" required>
                                    <option value="Yıllık İzin">Yıllık İzin</option>
                                    <option value="Hastalık İzni">Hastalık İzni</option>
                                    <option value="Ücretsiz İzin">Ücretsiz İzin</option>
                                    <option value="Mazeret İzni">Mazeret İzni</option>
                                </select>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <label class="form-label x-small fw-bold text-muted">BAŞLANGIÇ</label>
                                    <input type="datetime-local" id="event_start_izin" name="izin_baslangic_tarihi" class="form-control rounded-3" required>
                                </div>
                                <div class="col-6">
                                    <label class="form-label x-small fw-bold text-muted">BİTİŞ</label>
                                    <input type="datetime-local" id="event_end_izin" name="izin_bitis_tarihi" class="form-control rounded-3" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label x-small fw-bold text-muted">AÇIKLAMA</label>
                                <textarea name="izin_aciklama" class="form-control rounded-3" rows="2" placeholder="İzin gerekçesi..."></textarea>
                            </div>
                            <div class="d-grid"><button type="submit" class="btn btn-success py-2 rounded-3 fw-bold text-white">İzin Talebi Oluştur</button></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fc .fc-toolbar-title { font-size: 1.1rem; font-weight: 800; color: #0f172a; }
    .fc .fc-button { background: #f1f5f9 !important; border: none !important; color: #475569 !important; padding: 0.4rem 0.8rem !important; border-radius: 0.5rem !important; font-weight: 600 !important; font-size: 0.8rem !important; }
    .fc .fc-button-active { background: #3b82f6 !important; color: white !important; }
    .fc-compact .fc-view-harness { height: 450px !important; }
    .fc-event { border: none !important; padding: 2px 5px !important; border-radius: 4px !important; font-size: 0.75rem !important; }
    .btn-glass { background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); transition: all 0.3s; border-radius: 1rem; }
    .btn-glass:hover { background: rgba(255,255,255,0.2); transform: translateY(-3px); }
</style>

