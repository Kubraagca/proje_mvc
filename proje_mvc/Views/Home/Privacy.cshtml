@{
    ViewData["Title"] = "Güvenlik ve Gizlilik";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center">
        <div class="card-premium p-5 shadow-lg border-0">
            <div class="mb-4">
                <i class="bi bi-shield-shaded text-primary" style="font-size: 4rem;"></i>
            </div>
            <h2 class="fw-bold text-primary mb-3">Veri Güvenliğiniz Bizim İçin Önemli</h2>
            <p class="text-muted mb-5">ZENITH CORE olarak verilerinizin güvenliğini ve gizliliğini en üst düzeyde koruyoruz. Tüm süreçlerimiz KVKK ve uluslararası standartlara uygun olarak yönetilmektedir.</p>
            
            <div class="row g-4 mb-5 text-start">
                <div class="col-md-6">
                    <div class="d-flex align-items-center p-3 bg-light rounded-4">
                        <i class="bi bi-lock-fill fs-3 text-primary me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Uçtan Uca Şifreleme</h6>
                            <span class="x-small text-muted">Verileriniz güvenli kanallar ile iletilir.</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex align-items-center p-3 bg-light rounded-4">
                        <i class="bi bi-person-badge-fill fs-3 text-primary me-3"></i>
                        <div>
                            <h6 class="fw-bold mb-0">Yetki Yönetimi</h6>
                            <span class="x-small text-muted">Yalnızca yetkili personel verilere erişebilir.</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-grid gap-3">
                <a href="/Home/gizlilik_politikası" class="btn btn-primary-corporate py-3 rounded-pill fw-bold">
                    <i class="bi bi-file-earmark-text me-2"></i> Detaylı Gizlilik Politikasını Oku
                </a>
                <a href="/Home/Index" class="btn btn-link text-muted text-decoration-none">
                    <i class="bi bi-arrow-left me-2"></i> Panele Dön
                </a>
            </div>
        </div>
    </div>
</div>

