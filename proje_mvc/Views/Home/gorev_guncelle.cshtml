@model proje_mvc.Models.GorevModel

@{
    ViewData["Title"] = "Görev Detaylarını Güncelle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-premium overflow-hidden">
            <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-clipboard-check me-2"></i> Görev Kaydı Düzenleme</h5>
                <a href="/Home/gorev_listele" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-2"></i> Listeye Dön
                </a>
            </div>

            <div class="p-4 bg-white">
                <form asp-action="gorev_guncelle" asp-controller="Home" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="gorev_id" value="@Model.gorev_id" />
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Sorumlu Personel</label>
                            <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle text-primary me-3">
                                    <i class="bi bi-person-badge"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@Model.ad @Model.soyad</div>
                                    <div class="text-muted small">Personel ID: #@Model.personel_id</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Görev Başlığı / Tanımı</label>
                            <input type="text" name="gorev_adi" value="@Model.gorev_adi" class="form-control rounded-3" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Görev Detayları ve Talimatlar</label>
                            <textarea name="gorev_aciklama" class="form-control rounded-3" rows="4">@Model.gorev_aciklama</textarea>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Başlangıç Tarihi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-event"></i></span>
                                <input type="date" name="gorev_baslangic_tarihi" value="@Model.gorev_baslangic_tarihi?.ToString("yyyy-MM-dd")" class="form-control rounded-end-3 border-start-0" required />
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                             <label class="form-label small fw-bold text-muted">Durum Güncelle</label>
                             <select name="gorev_durumu" class="form-select rounded-3">
                                 <option value="Beklemede" selected="@(Model.gorev_durumu == "Beklemede" ? "selected" : null)">Beklemede</option>
                                 <option value="Devam Ediyor" selected="@(Model.gorev_durumu == "Devam Ediyor" ? "selected" : null)">Devam Ediyor</option>
                                 <option value="Tamamlandı" selected="@(Model.gorev_durumu == "Tamamlandı" ? "selected" : null)">Tamamlandı</option>
                             </select>
                        </div>

                        <div class="col-12 text-end mt-5 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-corporate px-5 py-2 fw-bold">
                                Görevi Güncelle <i class="bi bi-send-check ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
