@model List<proje_mvc.Models.GorevModel>
@{
    ViewData["Title"] = "Görev Takibi";
}

<div class="card-premium overflow-hidden">
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light bg-opacity-50">
        <h5 class="mb-0 fw-bold"><i class="bi bi-list-task me-2 text-primary"></i> Operasyonel Görev Listesi</h5>
        <div class="d-flex gap-2">
            <div class="input-group input-group-sm" style="width: 250px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" id="gorevSearch" class="form-control border-start-0" placeholder="Görev ara..." onkeyup="searchGorev()">
            </div>
            <a href="/Home/gorev_ekle" class="btn btn-primary-corporate btn-sm rounded-pill px-4">
                <i class="bi bi-plus-lg me-2"></i> Yeni Görev Tanımla
            </a>
        </div>
    </div>
    
    <div class="p-0">
        <table class="table-corporate mb-0" id="gorevTable">
            <thead>
                <tr>
                    <th>Sorumlu Personel</th>
                    <th>Görev Adı</th>
                    <th>Başlangıç Tarihi</th>
                    <th>Durum</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var gorev in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@gorev.ad @gorev.soyad</div>
                            <span class="text-muted small">ID: #@gorev.personel_id</span>
                        </td>
                        <td>
                            <div class="fw-semibold">@gorev.gorev_adi</div>
                            <div class="small text-muted text-truncate" style="max-width: 300px;">@gorev.gorev_aciklama</div>
                        </td>
                        <td>
                            <div class="small text-secondary fw-medium">@gorev.gorev_baslangic_tarihi?.ToString("dd.MM.yyyy")</div>
                        </td>
                        <td>
                            @{
                                var statusClass = gorev.gorev_durumu == "Tamamlandı" ? "success" : 
                                                 gorev.gorev_durumu == "Devam Ediyor" ? "primary" : "warning";
                            }
                            <span class="badge rounded-pill bg-@statusClass bg-opacity-10 text-@statusClass border border-@statusClass border-opacity-25 px-3">
                                @gorev.gorev_durumu
                            </span>
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-link link-primary p-0 me-3" 
                                    onclick="openModal('@gorev.gorev_id','@gorev.personel_id','@gorev.ad','@gorev.soyad','@gorev.gorev_adi','@gorev.gorev_aciklama','@gorev.gorev_baslangic_tarihi?.ToString("yyyy-MM-dd")','@gorev.gorev_durumu')">
                                <i class="bi bi-pencil-square fs-5"></i>
                            </button>
                            <form asp-action="gorev_sil" asp-controller="Home" method="post" style="display:inline">
                                <input type="hidden" name="gorev_id" value="@gorev.gorev_id" />
                                <button type="submit" class="btn btn-link link-danger p-0" onclick="return confirm('Bu görevi silmek istediğinizden emin misiniz?');">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="guncelleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem;">
            <div class="modal-header bg-primary text-white" style="border-top-left-radius: 1rem; border-top-right-radius: 1rem;">
                <h5 class="modal-title fw-bold">Görev Güncelleme</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form method="post" action="/Home/gorev_guncelle">
                    <input type="hidden" name="gorev_id" id="modal_gorev_id" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Görev Adı</label>
                            <input type="text" id="modal_gorev_adi" name="gorev_adi" class="form-control rounded-3" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Personel ID</label>
                            <input type="number" id="modal_personel_id" name="personel_id" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Başlangıç Tarihi</label>
                            <input type="date" id="modal_gorev_baslangic_tarihi" name="gorev_baslangic_tarihi" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Durum</label>
                            <select id="modal_gorev_durumu" name="gorev_durumu" class="form-select rounded-3">
                                <option value="Beklemede">Beklemede</option>
                                <option value="Devam Ediyor">Devam Ediyor</option>
                                <option value="Tamamlandı">Tamamlandı</option>
                                <option value="İptal Edildi">İptal Edildi</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Açıklama</label>
                            <textarea id="modal_gorev_aciklama" name="gorev_aciklama" class="form-control rounded-3" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary-corporate rounded-pill px-4">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function searchGorev() {
            var input = document.getElementById('gorevSearch');
            var filter = input.value.toUpperCase();
            var table = document.getElementById("gorevTable");
            var tr = table.getElementsByTagName("tr");

            for (var i = 1; i < tr.length; i++) {
                var found = false;
                var tds = tr[i].getElementsByTagName("td");
                for (var j = 0; j < tds.length; j++) {
                    if (tds[j].textContent.toUpperCase().indexOf(filter) > -1) {
                        found = true;
                        break;
                    }
                }
                tr[i].style.display = found ? "" : "none";
            }
        }

        function openModal(id, p_id, ad, soyad, gorev_adi, aciklama, baslangic, durum) {
            document.getElementById("modal_gorev_id").value = id;
            document.getElementById("modal_personel_id").value = p_id;
            document.getElementById("modal_gorev_adi").value = gorev_adi;
            document.getElementById("modal_gorev_aciklama").value = aciklama;
            document.getElementById("modal_gorev_baslangic_tarihi").value = baslangic;
            document.getElementById("modal_gorev_durumu").value = durum;

            var myModal = new bootstrap.Modal(document.getElementById('guncelleModal'));
            myModal.show();
        }
    </script>
}
