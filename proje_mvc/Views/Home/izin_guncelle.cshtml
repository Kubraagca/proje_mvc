@model proje_mvc.Models.IzinModel

@{
    ViewData["Title"] = "İzin Kaydını Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card-premium overflow-hidden">
            <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-calendar-check me-2"></i> İzin Kaydı Düzenleme</h5>
                <a href="/Home/izin_listele" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-2"></i> Listeye Dön
                </a>
            </div>

            <div class="p-4 bg-white">
                <form asp-action="izin_guncelle" asp-controller="Home" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="izin_id" value="@Model.izin_id" />
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="row g-4">
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Personel</label>
                            <div class="d-flex align-items-center p-3 bg-light rounded-3 border">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-circle text-primary me-3">
                                    <i class="bi bi-person-walking"></i>
                                </div>
                                <div>
                                    <div class="fw-bold">@Model.ad @Model.soyad</div>
                                    <div class="text-muted small">Personel ID: #@Model.personel_id</div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">İzin Türü</label>
                            <select name="izin_turu" class="form-select rounded-3 shadow-sm border-primary border-opacity-25">
                                <option value="Yıllık İzin" selected="@(Model.izin_turu == "Yıllık İzin" ? "selected" : null)">Yıllık İzin</option>
                                <option value="Raporlu" selected="@(Model.izin_turu == "Raporlu" ? "selected" : null)">Raporlu</option>
                                <option value="Ücretsiz İzin" selected="@(Model.izin_turu == "Ücretsiz İzin" ? "selected" : null)">Ücretsiz İzin</option>
                                <option value="Mazeret İzni" selected="@(Model.izin_turu == "Mazeret İzni" ? "selected" : null)">Mazeret İzni</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Başlangıç Tarihi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-plus"></i></span>
                                <input type="date" name="izin_baslangic_tarihi" value="@Model.izin_baslangic_tarihi?.ToString("yyyy-MM-dd")" class="form-control rounded-end-3 border-start-0" required />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Bitiş Tarihi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-minus"></i></span>
                                <input type="date" name="izin_bitis_tarihi" value="@Model.izin_bitis_tarihi?.ToString("yyyy-MM-dd")" class="form-control rounded-end-3 border-start-0" required />
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">İzin Nedeni / Açıklama</label>
                            <textarea name="izin_aciklama" class="form-control rounded-3" rows="3">@Model.izin_aciklama</textarea>
                        </div>

                        <div class="col-12 text-end mt-5 pt-3 border-top">
                            <button type="submit" class="btn btn-primary-corporate px-5 py-2 fw-bold">
                                İzin Kaydını Güncelle <i class="bi bi-check2-all ms-2"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
