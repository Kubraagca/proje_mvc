@model proje_mvc.Models.KartModel

@{
    ViewData["Title"] = "Erişim Kartı Düzenle";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-premium overflow-hidden">
            <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-credit-card-2-front me-2"></i> Erişim Kartı Düzenleme</h5>
                <a href="/Home/kart_listesi" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-2"></i> Listeye Dön
                </a>
            </div>

            <div class="p-4 bg-white">
                <form asp-action="kart_guncelle" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="kart_id" value="@Model.kart_id" />
                    <input type="hidden" name="Id" value="@Model.Id" />

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Personel Ataması</label>
                        <select name="personel_id" class="form-select rounded-3">
                            @foreach (var p in ViewBag.Personeller)
                            {
                                <option value="@p.Id" selected="@(Model.personel_id?.ToString() == p.Id.ToString() ? "selected" : null)">@p.ad_soyad</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Bağlı Kurum</label>
                        <select name="kurum_id" class="form-select rounded-3">
                            @foreach (var k in ViewBag.Kurumlar)
                            {
                                <option value="@k.Id" selected="@(Model.kurum_id?.ToString() == k.Id.ToString() ? "selected" : null)">@k.kurum_adi</option>
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Sistem Kayıt Tarihi</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-check"></i></span>
                            <input type="date" name="kayit_tarihi" value="@Model.kayit_tarihi.ToString("yyyy-MM-dd")" class="form-control rounded-end-3 border-start-0" required />
                        </div>
                    </div>

                    <div class="p-3 bg-primary bg-opacity-10 rounded-4 mb-4 border border-primary border-opacity-10">
                        <div class="d-flex align-items-center">
                            <div class="text-primary me-3">
                                <i class="bi bi-info-circle-fill fs-4"></i>
                            </div>
                            <div class="small text-primary fw-medium">
                                Kart Seri Numarası (UUID):<br/>
                                <span class="text-dark font-monospace">@Model.kart_id</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary-corporate py-2 fw-bold">
                            <i class="bi bi-save me-2"></i> Kart Bilgilerini Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
