@model proje_mvc.Models.KurumModel

@{
    ViewData["Title"] = "Yeni Kurum Kaydı";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card-premium overflow-hidden">
            <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-building-add me-2"></i> Yeni Kurum Tanımla</h5>
                <a href="/Home/kurum_listele" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-2"></i> Listeye Dön
                </a>
            </div>

            <div class="p-4 bg-white">
                <form method="post" action="/Home/kurum_ekle">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">Kurum Adı</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-building"></i></span>
                            <input type="text" name="kurum_adi" class="form-control rounded-end-3 border-start-0" required placeholder="Tam ticari unvan giriniz..." />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted">İletişim Numarası</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-telephone"></i></span>
                            <input type="tel" name="iletisim_no" class="form-control rounded-end-3 border-start-0" required placeholder="05XX XXX XX XX" />
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-4 mb-4">
                        <p class="small text-muted mb-0">
                            <i class="bi bi-info-circle me-2"></i> Kurum kaydı yapıldıktan sonra bu kuruma bağlı personel tanımlaması yapabilirsiniz.
                        </p>
                    </div>

                    <div class="d-grid mt-2">
                        <button type="submit" class="btn btn-primary-corporate py-2 fw-bold">
                            <i class="bi bi-check-circle me-2"></i> Kurumu Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
