@model List<proje_mvc.Models.KurumModel>

@{
    ViewData["Title"] = "Kurum Yönetimi";
}

<div class="card-premium overflow-hidden">
    <div class="p-4 border-bottom bg-light bg-opacity-50 d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-primary"><i class="bi bi-building-gear me-2"></i> Kurum Portföyü</h5>
        <a href="/Home/kurum_ekle" class="btn btn-primary-corporate btn-sm">
            <i class="bi bi-plus-circle me-2"></i> Yeni Kurum Ekle
        </a>
    </div>

    <div class="p-4 bg-white border-bottom">
        <form method="get" action="@Url.Action("kurum_listele")" id="searchForm" class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Arama (ID)</label>
                <input type="text" name="searchId" class="form-control" placeholder="Kurum ID..." value="@Context.Request.Query["searchId"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Kurum Adı</label>
                <input type="text" name="searchName" class="form-control" placeholder="Kurum Adı..." value="@Context.Request.Query["searchName"]" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">İletişim No</label>
                <input type="tel" name="searchPhone" class="form-control" placeholder="Sıfır olmadan..." value="@Context.Request.Query["searchPhone"]" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary-corporate w-100">Filtrele</button>
                <button type="button" class="btn btn-outline-secondary w-100" onclick="clearForm()">Temizle</button>
            </div>
        </form>
    </div>

    <div class="table-responsive p-0">
        <table class="table table-corporate mb-0">
            <thead>
                <tr>
                    <th class="ps-4">Kurum Adı</th>
                    <th>İletişim No</th>
                    <th>Kurumsal ID</th>
                    <th class="text-end pe-4">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kurum in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 p-2 rounded-3 text-primary me-3">
                                    <i class="bi bi-building"></i>
                                </div>
                                <span class="fw-semibold">@kurum.kurum_adi</span>
                            </div>
                        </td>
                        <td>
                            <a href="tel:@kurum.iletisim_no" class="text-decoration-none text-muted">
                                <i class="bi bi-telephone me-2"></i> @kurum.iletisim_no
                            </a>
                        </td>
                        <td><span class="badge bg-light text-dark border fw-medium px-3">@kurum.Id</span></td>
                        <td class="text-end pe-4">
                            <div class="btn-group">
                                <button class="btn btn-sm btn-outline-primary rounded-start-pill px-3" onclick="openModal('@kurum.kurum_adi', '@kurum.iletisim_no', '@kurum.Id', '@kurum.kurum_id')">
                                    <i class="bi bi-pencil-square"></i> Düzenle
                                </button>
                                <form method="post" action="@Url.Action("kurum_sil", "Home")" class="d-inline">
                                    <input type="hidden" name="kurum_id" value="@kurum.kurum_id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-end-pill px-3" onclick="return confirm('Silmek istediğinizden emin misiniz?');">
                                        <i class="bi bi-trash"></i> Sil
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Kurum Güncelleme Modalı -->
<div class="modal fade" id="guncelleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-primary text-white border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i> Kurum Bilgilerini Güncelle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <form id="kurumGuncelleForm" method="post" action="/Home/kurum_guncelle">
                <div class="modal-body p-4">
                    <input type="hidden" name="kurum_id" id="modal_kurum_id" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Kurum Adı</label>
                        <input type="text" name="kurum_adi" id="modal_kurum_adi" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">İletişim No</label>
                        <input type="tel" name="iletisim_no" id="modal_iletisim_no" class="form-control rounded-3" required />
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-bold">Sistem Kayıt ID (Numara)</label>
                        <input type="number" name="Id" id="modal_Id" class="form-control rounded-3" required />
                    </div>
                </div>
                <div class="modal-footer border-0 p-4 pt-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary-corporate px-4 rounded-pill">Değişiklikleri Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function clearForm() {
            document.getElementById('searchForm').reset();
            window.location.href = window.location.pathname;
        }

        function openModal(kurum_adi, iletisim_no, Id, kurum_id) {
            document.getElementById("modal_kurum_adi").value = kurum_adi;
            document.getElementById("modal_iletisim_no").value = iletisim_no;
            document.getElementById("modal_Id").value = Id;
            document.getElementById("modal_kurum_id").value = kurum_id;
            
            new bootstrap.Modal(document.getElementById('guncelleModal')).show();
        }
    </script>
}
