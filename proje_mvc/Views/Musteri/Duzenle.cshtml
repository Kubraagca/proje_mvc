@model proje_mvc.Models.MusteriModel
@{
    ViewData["Title"] = "Müşteri/Cari Düzenle";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card-premium">
            <div class="p-4 border-bottom bg-light bg-opacity-50">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2 text-primary"></i> Müşteri & Cari Kart Düzenleme</h5>
                <p class="text-muted small mb-0 mt-1">Cari hesap bilgilerini güncellemek için aşağıdaki formu kullanınız.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Duzenle" method="post">
                    <input type="hidden" asp-for="id" />
                    <input type="hidden" asp-for="olusturma_tarihi" />
                    
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="unvan" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="unvan" class="form-control rounded-3" placeholder="Firma Ünvanı veya Şahıs Ad Soyad..." />
                            <span asp-validation-for="unvan" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="tip" class="form-label small fw-bold text-muted"></label>
                            <select asp-for="tip" class="form-select rounded-3">
                                <option value="Kurumsal">Kurumsal (Firma)</option>
                                <option value="Bireysel">Bireysel (Şahıs)</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="vergi_dairesi" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="vergi_dairesi" class="form-control rounded-3" placeholder="Vergi Dairesi..." />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="vergi_no" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="vergi_no" class="form-control rounded-3" placeholder="Vergi No veya TC Kimlik..." />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="telefon" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="telefon" class="form-control rounded-3" placeholder="0212 XXX XX XX" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="eposta" class="form-label small fw-bold text-muted"></label>
                            <input asp-for="eposta" type="email" class="form-control rounded-3" placeholder="ornek@firma.com" />
                        </div>

                        <div class="col-12">
                            <label asp-for="adres" class="form-label small fw-bold text-muted"></label>
                            <textarea asp-for="adres" class="form-control rounded-3" rows="3" placeholder="Detaylı adres bilgisi..."></textarea>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border border-primary border-opacity-25">
                                <label asp-for="bakiye" class="form-label small fw-bold text-muted">Mevcut Bakiye</label>
                                <div class="input-group">
                                    <input asp-for="bakiye" type="number" step="0.01" class="form-control border-end-0 bg-white" />
                                    <span class="input-group-text bg-white border-start-0 text-primary">₺</span>
                                </div>
                                <div class="small text-muted mt-1 italic">Borç (-) / Alacak (+)</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/Musteri/Index" class="btn btn-secondary rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-primary-corporate rounded-pill px-5">
                            <i class="bi bi-check-circle me-2"></i> Bilgileri Güncelle
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
