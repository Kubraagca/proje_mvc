<div class="card-premium overflow-hidden">
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light bg-opacity-50">
        <h5 class="mb-0 fw-bold"><i class="bi bi-person-rolodex me-2 text-primary"></i> Müşteri & Cari Yönetimi (CRM)</h5>
        <a href="/Musteri/Ekle" class="btn btn-primary-corporate btn-sm rounded-pill px-4">
            <i class="bi bi-person-plus me-2"></i> Yeni Müşteri
        </a>
    </div>
    <div class="p-0">
        <table class="table-corporate mb-0">
            <thead>
                <tr>
                    <th>Ünvan / Ad Soyad</th>
                    <th>İletişim</th>
                    <th>Vergi Bilgileri</th>
                    <th>Cari Bakiye</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">@item.unvan</div>
                            <span class="badge bg-primary bg-opacity-10 text-primary small">@item.tip</span>
                        </td>
                        <td>
                            <div class="small"><i class="bi bi-telephone me-2 text-muted"></i>@item.telefon</div>
                            <div class="small text-muted"><i class="bi bi-envelope me-2"></i>@item.eposta</div>
                        </td>
                        <td>
                            <div class="small text-secondary">@item.vergi_dairesi</div>
                            <div class="small text-muted">@item.vergi_no</div>
                        </td>
                        <td>
                            <span class="fw-bold @(item.bakiye < 0 ? "text-danger" : "text-success")">
                                @item.bakiye.ToString("C2")
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="/Musteri/Duzenle/@item.id" class="btn btn-link link-primary p-0 me-3">
                                <i class="bi bi-pencil-square fs-5"></i>
                            </a>
                            <form asp-controller="Musteri" asp-action="Sil" asp-route-id="@item.id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-link link-danger p-0" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
