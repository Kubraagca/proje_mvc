@model ErrorViewModel
@{
    ViewData["Title"] = "Hata - ERP Core";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 text-center">
        <div class="display-1 text-danger mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h1 class="fw-bold text-primary">Bir Sorun Oluştu</h1>
        <p class="text-muted lead mb-5">İsteğiniz işlenirken beklenmedik bir hata meydana geldi.</p>

        <div class="card-premium p-4 mb-5 text-start border-start border-danger border-4">
            <h6 class="text-uppercase small fw-bold text-muted mb-2">Hata Detayları</h6>
            @if (Model.ShowRequestId)
            {
                <p class="mb-0 font-monospace small">Hata ID: <span class="text-danger">@Model.RequestId</span></p>
            }
            else
            {
                <p class="mb-0 small">Sistem günlüğü incelenmek üzere kaydedildi.</p>
            }
        </div>

        <div class="d-flex justify-content-center gap-3">
            <a href="/Home/Index" class="btn btn-primary-corporate px-4 py-2">
                <i class="bi bi-house-door me-2"></i> Panele Dön
            </a>
            <button onclick="location.reload()" class="btn btn-outline-secondary px-4 py-2 rounded-pill">
                <i class="bi bi-arrow-clockwise me-2"></i> Tekrar Dene
            </button>
        </div>
    </div>
</div>
