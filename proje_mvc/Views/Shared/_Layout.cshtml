<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ZENITH Kurumsal</title>

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <!-- Custom Sidebar CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h4 class="mb-0 text-white"><i class="bi bi-hexagon-fill text-primary-light"></i> <span class="fw-extrabold">ZENITH</span> CORE</h4>
        </div>

        <div class="nav-section-title">Ana Menü</div>
        <a href="/home/index" class="nav-link-corporate active">
            <i class="bi bi-grid-1x2-fill"></i> Panel
        </a>

        @if (User.Identity.IsAuthenticated)
        {
            <div class="nav-section-title">Departmanlar</div>
            
            <a class="nav-link-corporate" data-bs-toggle="collapse" href="#hrSub">
                <i class="bi bi-people-fill"></i> Personel & İzin Yönetimi <i class="bi bi-chevron-down ms-auto fs-xs"></i>
            </a>
            <div class="collapse show" id="hrSub">
                <a href="/home/personel_listele" class="nav-link-corporate ms-4 py-1 small">Personel Listesi</a>
                <a href="/home/izin_listele" class="nav-link-corporate ms-4 py-1 small">İzin Talepleri</a>
                <a href="/home/gorev_listele" class="nav-link-corporate ms-4 py-1 small">Görev Takibi</a>
            </div>

            <!-- Operations -->
            <a href="/Stok/Index" class="nav-link-corporate">
                <i class="bi bi-box-seam-fill"></i> Stok & Envanter
            </a>
            <a href="/Musteri/Index" class="nav-link-corporate">
                <i class="bi bi-person-rolodex"></i> CRM & Müşteri
            </a>
            <a href="/Finans/Index" class="nav-link-corporate">
                <i class="bi bi-safe2-fill"></i> Finans & Kasa
            </a>
            <a href="/Home/Mesajlar" class="nav-link-corporate">
                <i class="bi bi-chat-dots-fill"></i> Mesajlaşma
                <span class="badge bg-danger rounded-pill x-small ms-auto">Canlı</span>
            </a>

            <div class="nav-section-title">Sistem</div>
            <a href="/home/ayarlar" class="nav-link-corporate">
                <i class="bi bi-gear-fill"></i> Ayarlar
            </a>
        }
    </div>

    <!-- TOP BAR -->
    <div class="top-bar shadow-sm">
        <div class="d-flex align-items-center">
            <button class="btn btn-link link-dark p-0 me-3 d-lg-none" type="button">
                <i class="bi bi-list fs-3"></i>
            </button>
            <h5 class="mb-0 fw-semibold text-secondary">@ViewData["Title"]</h5>
        </div>
        
        <div class="d-flex align-items-center">
            @if (User.Identity.IsAuthenticated)
            {
                <div class="dropdown me-3">
                    <button class="btn btn-link link-dark dropdown-toggle text-decoration-none p-0" type="button" data-bs-toggle="dropdown">
                        Hoş geldiniz, <b>@User.Identity.Name</b>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2">
                        <li><a class="dropdown-item py-2 px-3" href="/Home/Profil"><i class="bi bi-person-circle me-2"></i> Profilim</a></li>
                        <li><a class="dropdown-item py-2 px-3" href="/Home/ayarlar"><i class="bi bi-gear me-2"></i> Ayarlar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item py-2 px-3 text-danger" href="/Home/Cikis"><i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a href="/Home/Giris" class="btn btn-primary rounded-pill px-4">Giriş Yap</a>
            }
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <main class="main-content">
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
