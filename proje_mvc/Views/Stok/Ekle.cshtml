@model proje_mvc.Models.UrunModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card-premium">
            <div class="p-4 border-bottom bg-light bg-opacity-50">
                <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i> Yeni Ürün & Stok Kartı Tanımlama</h5>
                <p class="text-muted small mb-0 mt-1">Sistem envanterine yeni bir ürün veya hizmet kartı eklemek için aşağıdaki formu doldurunuz.</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Ekle" method="post">
                    <div class="row g-4">
                        <div class="col-md-8">
                            <label asp-for="ad" class="form-label small fw-bold text-muted">Ürün Adı / Tanımı</label>
                            <input asp-for="ad" class="form-control rounded-3" placeholder="Örn: Laptop, Temizlik Hizmeti..." />
                            <span asp-validation-for="ad" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="kod" class="form-label small fw-bold text-muted">Ürün Kodu (SKU)</label>
                            <input asp-for="kod" class="form-control rounded-3" placeholder="Örn: STK-001" />
                        </div>
                        
                        <div class="col-md-6">
                            <label asp-for="kategori" class="form-label small fw-bold text-muted">Kategori</label>
                            <select asp-for="kategori" class="form-select rounded-3">
                                <option value="Genel">Genel</option>
                                <option value="Hammadde">Hammadde</option>
                                <option value="Yarı Mamül">Yarı Mamül</option>
                                <option value="Mamül">Mamül</option>
                                <option value="Hizmet">Hizmet</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="birim" class="form-label small fw-bold text-muted">Ölçü Birimi</label>
                            <input asp-for="birim" class="form-control rounded-3" placeholder="Adet, KG, m2, Saat..." />
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <label asp-for="stok_miktari" class="form-label small fw-bold text-muted">Mevcut Stok</label>
                                <div class="input-group">
                                    <input asp-for="stok_miktari" type="number" step="0.01" class="form-control border-end-0 bg-white" />
                                    <span class="input-group-text bg-white border-start-0 text-muted"><i class="bi bi-layers"></i></span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3">
                                <label asp-for="alis_fiyati" class="form-label small fw-bold text-muted">Birim Alış Fiyatı</label>
                                <div class="input-group">
                                    <input asp-for="alis_fiyati" type="number" step="0.01" class="form-control border-end-0 bg-white" />
                                    <span class="input-group-text bg-white border-start-0 text-muted">₺</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border border-primary border-opacity-25">
                                <label asp-for="satis_fiyati" class="form-label small fw-bold text-muted">Birim Satış Fiyatı</label>
                                <div class="input-group">
                                    <input asp-for="satis_fiyati" type="number" step="0.01" class="form-control border-end-0 bg-white" />
                                    <span class="input-group-text bg-white border-start-0 text-primary">₺</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-5 pt-3 border-top d-flex justify-content-end gap-2">
                        <a href="/Stok/Index" class="btn btn-secondary rounded-pill px-4">İptal</a>
                        <button type="submit" class="btn btn-primary-corporate rounded-pill px-5">
                            <i class="bi bi-check-circle me-2"></i> Ürünü Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
