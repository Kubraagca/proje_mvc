<div class="card-premium overflow-hidden">
    <div class="d-flex justify-content-between align-items-center p-4 border-bottom bg-light bg-opacity-50">
        <h5 class="mb-0 fw-bold"><i class="bi bi-box-seam me-2 text-primary"></i> Stok & Envanter Yönetimi</h5>
        <a href="/Stok/Ekle" class="btn btn-primary-corporate btn-sm rounded-pill px-4">
            <i class="bi bi-plus-lg me-2"></i> Yeni Ürün Ekle
        </a>
    </div>
    <div class="p-0">
        <table class="table-corporate mb-0">
            <thead>
                <tr>
                    <th>Ürün Kodu</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Stok Miktarı</th>
                    <th>Satış Fiyatı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small fw-medium text-muted">@item.kod</td>
                        <td class="fw-bold text-dark">@item.ad</td>
                        <td>
                            <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3">
                                @item.kategori
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                <span class="fw-bold @(item.stok_miktari < 10 ? "text-danger" : "text-success")">
                                    @item.stok_miktari @item.birim
                                </span>
                                @if (item.stok_miktari < 10) {
                                    <i class="bi bi-exclamation-triangle-fill text-danger ms-2 small" title="Kritik Stok"></i>
                                }
                            </div>
                        </td>
                        <td class="fw-semibold">@item.satis_fiyati.ToString("C2")</td>
                        <td class="text-end">
                            <a href="/Stok/Duzenle/@item.id" class="btn btn-link link-primary p-0 me-3">
                                <i class="bi bi-pencil-square fs-5"></i>
                            </a>
                            <form asp-action="Sil" asp-route-id="@item.id" method="post" style="display:inline">
                                <button type="submit" class="btn btn-link link-danger p-0" onclick="return confirm('Silmek istediğinize emin misiniz?')">
                                    <i class="bi bi-trash3 fs-5"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
